# iRacing Telemetry Server Configuration

# WebSocket server host (0.0.0.0 allows connections from any IP)
WS_HOST=0.0.0.0

# WebSocket server port
WS_PORT=8080

# Telemetry update interval in milliseconds (100 = 10 updates/sec)
TELEMETRY_INTERVAL_MS=100

# Session info update interval in milliseconds
SESSION_INTERVAL_MS=1000
